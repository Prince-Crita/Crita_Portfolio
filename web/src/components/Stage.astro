---
// A project's signature composition: its main desktop screen with a phone
// screen overlapping, on the project's own stage colour. An app with no
// desktop screens shows three phones instead.
import BrowserFrame from './BrowserFrame.astro';
import PhoneFrame from './PhoneFrame.astro';
import { phonesOnly, heroPhones, type Project } from '../lib/content';

interface Props {
  project: Project;
  size?: 'card' | 'hero';
  eager?: boolean;
  vt?: boolean;
}
const { project: p, size = 'card', eager = false, vt = false } = Astro.props;
const dark = p.id === 'veloce';
const sizes = size === 'hero' ? '(min-width: 1100px) 70vw, 94vw' : '(min-width: 1100px) 46vw, 92vw';
const phones = phonesOnly(p) ? heroPhones(p) : null;
---
{phones ? (
  <div class:list={['stage', 'stage--phones', `stage--${size}`, `stage--${p.theme.stageInk}`]} style={`--stage:${p.theme.stage};--accent:${p.theme.accent}`}>
    <span class="stage__glow" aria-hidden="true"></span>
    <div class="stage__trio">
      {phones.map((k, i) => (
        <div
          class:list={['stage__p', i === 1 && 'stage__p--mid']}
          data-parallax={size === 'hero' ? (i === 1 ? '-0.05' : '0.03') : undefined}
          style={vt && i === 1 ? `view-transition-name:stage-${p.id}` : undefined}
        >
          <PhoneFrame k={k} sizes={size === 'hero' ? '(min-width: 1100px) 22vw, 30vw' : '(min-width: 1100px) 14vw, 28vw'} eager={eager && (i === 1 ? 'high' : true)} />
        </div>
      ))}
    </div>
  </div>
) : (
  <div class:list={['stage', `stage--${size}`, `stage--${p.theme.stageInk}`]} style={`--stage:${p.theme.stage};--accent:${p.theme.accent}`}>
    <span class="stage__glow" aria-hidden="true"></span>
    <div class="stage__desk" data-parallax={size === 'hero' ? '0.03' : undefined}>
      <BrowserFrame k={p.media.hero} url={p.name} tone={dark ? 'dark' : 'light'} sizes={sizes} eager={eager && 'high'} vt={vt ? `stage-${p.id}` : undefined} />
    </div>
    <div class="stage__phone" data-parallax={size === 'hero' ? '-0.05' : undefined}>
      <PhoneFrame k={p.media.heroPhone} sizes={size === 'hero' ? '(min-width: 1100px) 16vw, 34vw' : '(min-width: 1100px) 11vw, 26vw'} eager={eager} />
    </div>
  </div>
)}

<style>
  .stage {
    position: relative;
    isolation: isolate;
    border-radius: var(--r-stage);
    background: var(--stage);
    overflow: hidden;
    padding: 7% 13% 0 6%;
    aspect-ratio: 16 / 11;
  }
  .stage--hero { aspect-ratio: auto; padding: 0; overflow: visible; background: none; border-radius: 0; }
  .stage__glow {
    position: absolute; inset: auto -20% -60% 30%; height: 120%; z-index: -1;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 34%, transparent), transparent 72%);
    opacity: 0.55;
    pointer-events: none;
  }
  .stage--dark .stage__glow { opacity: 0.35; }
  .stage--hero .stage__glow { display: none; }
  .stage__desk { position: relative; z-index: 1; }
  .stage__phone {
    position: absolute; z-index: 2;
    width: 21%; right: 5%; bottom: -14%;
  }
  .stage--hero .stage__desk { width: 84%; }
  .stage--hero .stage__phone { width: 19%; right: 0; bottom: -10%; }

  /* Phones only: three phones in a row, the middle one forward and higher. */
  .stage--phones { padding: 7% 6% 0; }
  .stage__trio { display: flex; justify-content: center; align-items: flex-start; gap: 4%; }
  .stage__p { width: 25%; flex: none; margin-top: 7%; }
  .stage__p--mid { width: 29%; margin-top: 0; position: relative; z-index: 1; }
  .stage--phones.stage--hero { padding: 0; }
  .stage--hero .stage__trio { gap: 5%; }
  .stage--hero .stage__p { width: 24%; }
  .stage--hero .stage__p--mid { width: 27%; }
  @media (max-width: 600px) {
    .stage--hero .stage__trio { gap: 3%; }
    .stage--hero .stage__p { width: 30%; }
    .stage--hero .stage__p--mid { width: 34%; }
  }
</style>
