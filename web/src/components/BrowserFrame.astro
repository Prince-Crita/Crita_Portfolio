---
// A quiet browser window around a desktop screenshot. The image is cropped to
// the frame's aspect ratio from the top, so tall full-page captures also fit.
import Shot from './Shot.astro';

interface Props {
  k: string;
  /** Text in the address bar: the project name, never the app's real address. */
  url?: string;
  tone?: 'light' | 'dark';
  ratio?: string;
  sizes?: string;
  eager?: boolean;
  alt?: string;
  class?: string;
  style?: string;
  vt?: string;
  pick?: number;
}
const { k, url, tone = 'light', ratio = '16 / 10', sizes, eager, alt, class: cls, style, vt, pick } = Astro.props;
---
<figure class:list={['bframe', `bframe--${tone}`, cls]} style={`--ratio:${ratio};${vt ? `view-transition-name:${vt};` : ''}${style ?? ''}`}>
  <div class="bframe__bar" aria-hidden="true">
    <span class="bframe__dots"><i></i><i></i><i></i></span>
    {url && <span class="bframe__url">{url}</span>}
  </div>
  <div class="bframe__screen">
    <Shot k={k} sizes={sizes} eager={eager} alt={alt} pick={pick} />
  </div>
</figure>

<style>
  .bframe {
    margin: 0;
    border-radius: var(--r-frame);
    overflow: hidden;
    background: #fff;
    box-shadow: var(--shadow-frame), 0 0 0 1px rgba(13, 24, 19, 0.08);
    container-type: inline-size;
  }
  .bframe--dark { background: #0b1410; box-shadow: var(--shadow-frame), 0 0 0 1px rgba(238, 240, 230, 0.1); }
  .bframe__bar {
    display: flex; align-items: center; gap: 12px;
    height: clamp(22px, 2.6cqi, 36px);
    padding: 0 clamp(10px, 1.4cqi, 16px);
    background: #f1f1ec;
    border-bottom: 1px solid rgba(13, 24, 19, 0.07);
  }
  .bframe--dark .bframe__bar { background: #111c17; border-bottom-color: rgba(238, 240, 230, 0.07); }
  .bframe__dots { display: flex; gap: clamp(4px, 0.6cqi, 7px); }
  .bframe__dots i { width: clamp(6px, 0.8cqi, 10px); aspect-ratio: 1; border-radius: 50%; background: rgba(13, 24, 19, 0.16); }
  .bframe--dark .bframe__dots i { background: rgba(238, 240, 230, 0.18); }
  .bframe__url {
    margin-inline: auto; transform: translateX(-24px);
    max-width: 52%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    padding: 2px 14px; border-radius: 6px;
    font-size: clamp(8px, 1cqi, 12px); font-weight: 500; letter-spacing: 0.01em;
    color: rgba(13, 24, 19, 0.5); background: rgba(13, 24, 19, 0.05);
  }
  .bframe--dark .bframe__url { color: rgba(238, 240, 230, 0.5); background: rgba(238, 240, 230, 0.06); }
  .bframe__screen { aspect-ratio: var(--ratio); overflow: hidden; }
  .bframe__screen :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
</style>
