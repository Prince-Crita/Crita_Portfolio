---
import { company, projects, site } from '../lib/content';
---
<footer class="ftr on-dark" data-tone-section="dark">
  <div class="wrap">
    <div class="ftr__top">
      <div class="ftr__brand">
        <img src="/brand/crita-logo.svg" alt="Crita" width="132" height="25" />
        <p class="muted">{company.positioning}.<br />{company.headline}</p>
      </div>
      <nav class="ftr__col" aria-label="Selected work">
        <p class="label label--plain">Selected work</p>
        <ul>{projects.map((p) => <li><a href={`/work/${p.id}/`}>{p.name}</a></li>)}</ul>
      </nav>
      <div class="ftr__col">
        <p class="label label--plain">Contact</p>
        <ul>
          <li><a href={`mailto:${company.contact.email}`}>{company.contact.email}</a></li>
          <li><a href={company.contact.website} target="_blank" rel="noopener">{company.contact.websiteLabel}</a></li>
          <li><a href="/Crita-Portfolio-2026.pdf" download>Download the PDF portfolio</a></li>
        </ul>
      </div>
    </div>
    <div class="ftr__bottom small muted">
      <span>© {site.meta.year} {company.name}. All rights reserved.</span>
      <span>Product screens are real. Third-party names are anonymised where noted.</span>
    </div>
  </div>
</footer>

<style>
  .ftr { padding: clamp(4rem, 3rem + 4vw, 6.5rem) 0 2.2rem; border-top: 1px solid var(--line-dark); }
  .ftr__top { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 2.5rem; padding-bottom: 3.5rem; }
  .ftr__brand img { margin-bottom: 1.4rem; }
  .ftr__brand p { max-width: 34ch; }
  .ftr__col ul { display: grid; gap: 0.55rem; margin-top: 1.1rem; color: var(--on-dark-2); }
  .ftr__col a:hover { color: var(--on-dark); }
  .ftr__bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.8rem 2rem; padding-top: 1.8rem; border-top: 1px solid var(--line-dark); }
  @media (max-width: 820px) {
    .ftr__top { grid-template-columns: 1fr 1fr; }
    .ftr__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) { .ftr__top { grid-template-columns: 1fr; } }
</style>
