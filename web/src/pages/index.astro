---
import Base from '../layouts/Base.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, company, projects, projectById, projectCount, mailto } from '../lib/content';

const quotes = projects.filter((p) => p.quote);
const nameOf = (id: string) => projectById(id).name;
---
<Base tone="dark">
  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="hero on-dark" data-tone-section="dark">
    <div class="hero__bg" aria-hidden="true">
      <img class="hero__mark" src="/brand/crita-c-cream.svg" alt="" />
    </div>
    <div class="wrap hero__copy">
      <p class="label" data-reveal>{company.name} · Selected work {site.meta.year}</p>
      <h1 class="display hero__title" data-reveal style="--i:1">
        Software that brings <span class="hero__accent">clarity</span> to complex operations.
      </h1>
      <div class="hero__row" data-reveal style="--i:2">
        <p class="lead">{company.intro}</p>
        <div class="hero__cta">
          <a class="btn btn--lime" href="#work">Explore the work <span class="arrow">↓</span></a>
          <a class="btn btn--ghost" href="/Crita-Portfolio-2026.pdf" download>Download PDF</a>
        </div>
      </div>
    </div>

    <div class="wrap--wide hero__stage" aria-label="Screens from the four featured projects">
      <div class="hs hs--left" data-parallax="0.06">
        <BrowserFrame k={projectById('smc').tour[0].shot} url={projectById('smc').live.name} sizes="(min-width: 1100px) 40vw, 1px" eager />
      </div>
      <div class="hs hs--right" data-parallax="0.06">
        <BrowserFrame k="city-threads/admin-desktop/warehouse" url={projectById('city-threads').live.name} sizes="(min-width: 1100px) 40vw, 1px" eager />
      </div>
      <div class="hs hs--main">
        <BrowserFrame k={projectById('clario').media.hero} url={projectById('clario').live.name} sizes="(min-width: 1100px) 58vw, 94vw" eager />
      </div>
      <div class="hs hs--p1" data-parallax="-0.06">
        <PhoneFrame k="veloce/owner-mobile/inward-keypad" sizes="(min-width: 1100px) 14vw, 30vw" eager />
      </div>
      <div class="hs hs--p2" data-parallax="-0.09">
        <PhoneFrame k="smc/executive-mobile/visit-summary" sizes="(min-width: 1100px) 13vw, 30vw" eager />
      </div>
    </div>
  </section>

  <!-- ── About ────────────────────────────────────────────────── -->
  <section class="about" data-tone-section="light">
    <div class="wrap about__grid">
      <p class="label" data-reveal>{company.positioning}</p>
      <p class="h3 about__text" data-reveal style="--i:1">{company.about}</p>
      <dl class="about__stats" data-reveal style="--i:2">
        {company.stats.map((s) => (
          <div>
            <dt class="muted small">{s.label}</dt>
            <dd class="tnum">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ── Selected work ────────────────────────────────────────── -->
  <section id="work" class="section work" data-tone-section="light">
    <div class="wrap">
      <header class="work__head">
        <p class="label" data-reveal>Selected work</p>
        <h2 class="h2" data-reveal style="--i:1">{projectCount} platforms, each built around how the business actually works.</h2>
        <ol class="work__index" data-reveal style="--i:2">
          {projects.map((p) => (
            <li><a href={`/work/${p.id}/`}><span class="tnum">{p.number}</span>{p.name}</a></li>
          ))}
        </ol>
      </header>
      <div class="work__list">
        {projects.map((p, i) => <ProjectCard project={p} flip={i % 2 === 1} />)}
      </div>
    </div>
  </section>

  <!-- ── Capabilities ─────────────────────────────────────────── -->
  <section id="capabilities" class="section on-paper-2" data-tone-section="light">
    <div class="wrap">
      <header class="sec-head">
        <p class="label" data-reveal>Capabilities</p>
        <h2 class="h2" data-reveal style="--i:1">What we build for growing businesses.</h2>
        <p class="lead" data-reveal style="--i:2">Every capability below is demonstrated in the work on this page.</p>
      </header>
      <ol class="caps">
        {company.capabilities.map((c, i) => (
          <li class="cap" data-reveal style={`--i:${i % 3}`}>
            <span class="cap__num tnum">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h4">{c.title}</h3>
            <p class="muted">{c.body}</p>
            <p class="cap__proof">
              {c.proof.map((id) => <a class="chip" href={`/work/${id}/`}>{nameOf(id)}</a>)}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Approach ─────────────────────────────────────────────── -->
  <section id="approach" class="section on-forest approach" data-tone-section="dark">
    <div class="wrap">
      <header class="sec-head">
        <p class="label" data-reveal>How we work</p>
        <h2 class="h1" data-reveal style="--i:1">{company.approach.title}</h2>
        <p class="lead" data-reveal style="--i:2">We earn the right to build by understanding the business first.</p>
      </header>
      <ol class="steps">
        {company.approach.steps.map((s, i) => (
          <li class="step" data-reveal style={`--i:${i}`}>
            <span class="step__num tnum">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h3">{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Words ────────────────────────────────────────────────── -->
  <section class="section words" data-tone-section="light">
    <div class="wrap">
      <p class="label" data-reveal>In our clients’ words</p>
      <div class="words__grid">
        {quotes.map((p, i) => (
          <figure class="quote" data-reveal style={`--i:${i}`}>
            <blockquote class="h4">“{p.quote!.text}”</blockquote>
            <figcaption>
              <span class="quote__name">{p.quote!.name}</span>
              <span class="muted">{p.quote!.company}</span>
              <a class="link small" href={`/work/${p.id}/`}>{p.name} case study <span class="arrow">→</span></a>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Contact ──────────────────────────────────────────────── -->
  <section id="contact" class="section on-dark contact" data-tone-section="dark">
    <div class="contact__pattern" aria-hidden="true"></div>
    <div class="wrap contact__in">
      <p class="label" data-reveal>{company.closing.eyebrow}</p>
      <h2 class="display contact__title" data-reveal style="--i:1">{company.closing.headline}</h2>
      <p class="lead" data-reveal style="--i:2">{company.closing.body}</p>
      <div class="contact__cta" data-reveal style="--i:3">
        <a class="btn btn--lime" href={mailto('Project enquiry — from the Crita portfolio')}>{company.closing.cta} <span class="arrow">→</span></a>
        <a class="link" href={`mailto:${company.contact.email}`}>{company.contact.email}</a>
        <a class="link" href={company.contact.website} target="_blank" rel="noopener">{company.contact.websiteLabel} <span class="arrow">↗</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { position: relative; z-index: 1; padding-top: clamp(8.5rem, 6rem + 6vw, 11rem); overflow-x: clip; }
  .hero__bg { position: absolute; inset: 0; pointer-events: none; overflow: hidden;
    background:
      radial-gradient(60% 50% at 82% 8%, rgba(127, 165, 63, 0.16), transparent 70%),
      radial-gradient(50% 45% at 10% 70%, rgba(3, 63, 45, 0.55), transparent 70%);
  }
  .hero__mark { position: absolute; width: min(68vw, 980px); right: -16%; top: -6%; opacity: 0.035; }
  .hero__copy { position: relative; }
  .hero__title { margin-top: 1.6rem; max-width: 15.5ch; }
  .hero__accent { background: linear-gradient(90deg, var(--sprout), var(--lime)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero__row { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 2rem 3rem; margin-top: 2.4rem; }
  .hero__row .lead { max-width: 54ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  .hero__stage { position: relative; margin-top: clamp(3.5rem, 2rem + 4vw, 6rem); height: clamp(380px, 46vw, 760px); }
  .hs { position: absolute; }
  .hs--main { left: 50%; width: 58%; margin-left: -29%; top: 9%; z-index: 3; }
  .hs--left { left: 0; width: 40%; top: 0; z-index: 1; opacity: 0.92; }
  .hs--right { right: 0; width: 40%; top: 3%; z-index: 2; opacity: 0.92; }
  .hs--p1 { left: 13%; width: 13%; top: 34%; z-index: 4; }
  .hs--p2 { right: 12%; width: 12.5%; top: 42%; z-index: 4; }
  .hs--left :global(.bframe), .hs--right :global(.bframe) { filter: saturate(0.9) brightness(0.92); }

  @media (max-width: 820px) {
    /* Tall enough to hold the overlapping phone: 18% + 30% × 2.3 of the width. */
    .hero__stage { height: auto; aspect-ratio: 1 / 0.92; }
    .hs--left, .hs--right, .hs--p2 { display: none; }
    .hs--main { width: 92%; left: 0; margin-left: 0; top: 0; }
    .hs--p1 { left: auto; right: 0; width: 30%; top: 18%; }
  }

  /* About */
  .about { padding: clamp(4.5rem, 3rem + 5vw, 8rem) 0 0; }
  .about__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: 1.4rem; align-items: start; }
  .about__grid > .label { grid-column: 1 / span 3; padding-top: 0.6rem; }
  .about__text { grid-column: 4 / span 6; font-weight: 560; color: var(--ink); }
  .about__stats { grid-column: 10 / span 3; display: grid; gap: 1.4rem; }
  .about__stats dd { font-size: clamp(2.6rem, 2rem + 2vw, 4rem); font-weight: 650; letter-spacing: -0.04em; line-height: 1; margin-top: 0.3rem; }
  @media (max-width: 960px) {
    .about__grid > .label, .about__text, .about__stats { grid-column: 1 / -1; }
    .about__stats { grid-template-columns: repeat(2, 1fr); }
  }

  /* Work */
  .work__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: 1.2rem; margin-bottom: clamp(3.5rem, 2rem + 4vw, 6rem); }
  .work__head .label { grid-column: 1 / -1; }
  .work__head h2 { grid-column: 1 / span 8; }
  .work__index { grid-column: 10 / span 3; align-self: end; display: grid; gap: 0.35rem; font-weight: 560; }
  .work__index a { display: flex; gap: 0.9rem; color: var(--ink-2); padding: 0.35rem 0; border-bottom: 1px solid var(--line); transition: color 200ms; }
  .work__index a:hover { color: var(--ink); }
  .work__index span { color: var(--leaf); font-weight: 650; }
  .work__list { display: grid; gap: clamp(5rem, 3rem + 7vw, 10rem); }
  @media (max-width: 960px) {
    .work__head h2, .work__index { grid-column: 1 / -1; }
  }

  /* Section heads */
  .sec-head { max-width: 46rem; display: grid; gap: 1.1rem; margin-bottom: clamp(3rem, 2rem + 3vw, 5rem); }

  /* Capabilities */
  .caps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line-2); }
  .cap { padding: 2.2rem 2.2rem 2.4rem 0; border-bottom: 1px solid var(--line-2); display: grid; gap: 0.75rem; align-content: start; }
  .cap:not(:nth-child(3n + 1)) { padding-left: 2.2rem; border-left: 1px solid var(--line-2); }
  .cap__num { font-size: 0.85rem; font-weight: 650; color: var(--leaf); }
  .cap p.muted { max-width: 34ch; }
  .cap__proof { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.6rem; }
  .cap__proof .chip { font-size: 0.78rem; transition: background-color 200ms, border-color 200ms; }
  .cap__proof .chip:hover { background: var(--white); border-color: var(--ink); }
  @media (max-width: 960px) {
    .caps { grid-template-columns: 1fr 1fr; }
    .cap, .cap:not(:nth-child(3n + 1)) { padding: 2rem 1.4rem 2rem 0; border-left: 0; }
    .cap:nth-child(2n) { padding-left: 1.4rem; border-left: 1px solid var(--line-2); }
  }
  @media (max-width: 600px) {
    .caps { grid-template-columns: 1fr; }
    .cap, .cap:nth-child(2n) { padding: 1.8rem 0; border-left: 0; }
  }

  /* Approach */
  .approach .h1 { color: var(--on-dark); }
  .steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); }
  .step { display: grid; gap: 0.9rem; align-content: start; padding-top: 1.6rem; border-top: 1px solid var(--line-dark); position: relative; }
  .step::before { content: ''; position: absolute; top: -4px; left: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--lime); }
  .step__num { color: var(--lime); font-weight: 650; font-size: 0.9rem; }
  .step p { color: var(--on-dark-2); }
  @media (max-width: 900px) { .steps { grid-template-columns: 1fr 1fr; row-gap: 2.6rem; } }
  @media (max-width: 520px) { .steps { grid-template-columns: 1fr; } }

  /* Words */
  .words__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 1rem + 4vw, 5rem); margin-top: 2.4rem; }
  .quote blockquote { font-weight: 560; line-height: 1.45; letter-spacing: -0.014em; text-wrap: pretty; }
  .quote figcaption { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 0.9rem; margin-top: 1.6rem; padding-top: 1.2rem; border-top: 1px solid var(--line); }
  .quote__name { font-weight: 650; }
  .quote .link { margin-left: auto; }
  @media (max-width: 860px) { .words__grid { grid-template-columns: 1fr; } }

  /* Contact */
  .contact { overflow: hidden; }
  .contact__pattern { position: absolute; inset: 0; background: url('/brand/pattern-c.svg') right -80px center / 720px auto repeat-y; opacity: 0.07; mask-image: radial-gradient(70% 80% at 80% 50%, #000, transparent 75%); -webkit-mask-image: radial-gradient(70% 80% at 80% 50%, #000, transparent 75%); }
  .contact__in { position: relative; display: grid; gap: 1.6rem; }
  .contact__title { max-width: 14ch; }
  .contact__in .lead { max-width: 46ch; }
  .contact__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin-top: 1rem; }
  .contact__cta .link { color: var(--on-dark-2); }
  .contact__cta .link:hover { color: var(--on-dark); }
</style>
